# HaloFlow — local development environment template.
# Copy to .env and fill in.  .env is gitignored: never commit real secrets.
# Never load real PHI into a local database.
#
# NOTE ON SCOPE
#   DATABASE_URL and everything below "App" / vendor sections are read by
#   pydantic-settings (haloflow/config.py) directly from this .env file.
#   HALOFLOW_MIGRATION_DATABASE_URL and HALOFLOW_TEST_DATABASE_URL are read
#   with os.getenv() by alembic/env.py and tests/m01 — pydantic-settings does
#   NOT export .env into the process environment, so those two only work if
#   the file is sourced first.  `make migrate` / `make test` do that for you;
#   by hand use:  set -a; . ./.env; set +a

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
TENANT_ID=pilot-clinic-1
WEBHOOK_SECRET=local-dev-only-change-me

# ── Database ──────────────────────────────────────────────────────────────
# Runtime app connection. SQLAlchemy async driver form (postgresql+asyncpg://).
# Replace YOURUSER with your macOS username (`whoami`) for a Homebrew Postgres.
DATABASE_URL=postgresql+asyncpg://YOURUSER@localhost:5432/haloflow_dev

# Alembic migration path. Plain libpq form; alembic/env.py rewrites it to
# postgresql+psycopg://. Needs a role that can CREATE ROLE and CREATE SCHEMA.
HALOFLOW_MIGRATION_DATABASE_URL=postgresql://YOURUSER@localhost:5432/haloflow_dev

# M01 isolation test database. Plain libpq form.
# Hard requirements enforced by tests/m01/test_gateway_postgres.py:
#   - PostgreSQL 17 or newer
#   - database name must start with "haloflow_test"
#   - connecting role must be able to create roles and schemas (superuser is fine)
# Leave unset to skip the Postgres-backed M01 tests entirely.
HALOFLOW_TEST_DATABASE_URL=postgresql://YOURUSER@localhost:5432/haloflow_test_m01

# ── athenahealth ──────────────────────────────────────────────────────────
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_PRACTICE_ID=
ATHENA_BASE_URL=https://api.preview.platform.athenahealth.com

# ── Notifyre (SMS + fax) ──────────────────────────────────────────────────
NOTIFYRE_API_KEY=
NOTIFYRE_SMS_FROM=
NOTIFYRE_FAX_INBOUND_NUMBER=
NOTIFYRE_FAX_FROM_NUMBER=

# ── Stedi eligibility ─────────────────────────────────────────────────────
STEDI_API_KEY=

# ── Scheduling defaults ───────────────────────────────────────────────────
REMINDER_DAYS_BEFORE=2
ELIGIBILITY_DAYS_BEFORE=3
NO_SHOW_REBOOK_HOURS=24

# ── Priority payers (comma-separated Stedi payer IDs) ─────────────────────
# Comma-separated, NOT a JSON array — config.py marks this field NoDecode, so
# the raw string is handed to the parse_payer_ids validator, which splits on
# commas. A JSON array here would be split on its commas too and silently
# produce garbage. Comment the line out to use the code default.
PRIORITY_PAYER_IDS=ANTHM,UHC,SNTARA
