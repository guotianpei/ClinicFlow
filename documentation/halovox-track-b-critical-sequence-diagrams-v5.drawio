        <mxCell id="v4_shared" value="&lt;b&gt;Shared Schema&lt;/b&gt;&lt;br&gt;[PHI-containing]&lt;br&gt;Routing and durable provider-event intake; encrypted inbound payloads may be present." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
