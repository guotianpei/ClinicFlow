        <mxCell id="p8m6" value="7. Log caller, tenant, scope, decision" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;" edge="1" parent="1">
