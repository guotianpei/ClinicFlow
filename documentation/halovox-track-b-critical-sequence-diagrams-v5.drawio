        <mxCell id="v4_gcs" value="&lt;b&gt;GCS Tenant Storage&lt;/b&gt;&lt;br&gt;[PHI-containing]&lt;br&gt;Tenant-prefix isolated documents and artifacts with scoped credentials." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
