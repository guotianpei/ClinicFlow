        <mxCell id="p8n0" value="Broker prevents accidental wrong-SA selection, but not a fully compromised trusted application requesting another valid tenant_id." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="736" width="795" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="p8n1" value="Base app identity has no object permission; tenant SAs are prefix-scoped; only broker holds serviceAccountTokenCreator." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
