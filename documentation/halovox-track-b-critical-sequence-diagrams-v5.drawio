        </mxCell>
        <mxCell id="v4_emrs" value="&lt;b&gt;External EMRs&lt;/b&gt;&lt;br&gt;[External systems]&lt;br&gt;Authoritative appointment data and clinical operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
