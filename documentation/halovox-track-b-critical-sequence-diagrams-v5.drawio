  <diagram id="c4-container-v4" name="09 C4 High-Level Architecture">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v4_title" value="09 C4-Style High-Level Container Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="8" width="1550" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="v4_sub" value="Track B · clear plane separation, tenant isolation, trust boundaries, PHI classification, and connection timing · no table-level detail" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="32" y="43" width="1650" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="v4_gcp" value="GCP / BAA TRUST BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4b5563;strokeWidth=2;dashed=1;dashPattern=10 6;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="1680" height="1120" as="geometry"/>
        </mxCell>
        <mxCell id="v4_control" value="CONTROL PLANE — scheduler, watchdog, reconciliation, provisioning, and audited support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fillOpacity=20;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#4a2f57;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="1580" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="v4_data" value="DATA PLANE — every execution is bound to exactly one tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fillOpacity=18;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="1120" height="485" as="geometry"/>
        </mxCell>
        <mxCell id="v4_managed" value="MANAGED DATA &amp; PLATFORM SERVICES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fillOpacity=55;strokeColor=#9ca3af;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="300" y="845" width="1580" height="295" as="geometry"/>
        </mxCell>
        <mxCell id="v4_scheduler" value="&lt;b&gt;Scheduler &amp; Provisioning&lt;/b&gt;&lt;br&gt;[Control-plane containers]&lt;br&gt;Starts tenant jobs and provisions isolated resources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacing=9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="175" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v4_watchdog" value="&lt;b&gt;Central Watchdog&lt;/b&gt;&lt;br&gt;[Control-plane container]&lt;br&gt;Detects stalls and performs bounded recovery for one tenant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacing=9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="175" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v4_reconciler" value="&lt;b&gt;Reconciler&lt;/b&gt;&lt;br&gt;[Control-plane worker]&lt;br&gt;Converges uncertain provider and delivery state idempotently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacing=9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="175" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v4_support" value="&lt;b&gt;Support Access Service&lt;/b&gt;&lt;br&gt;[Privileged control-plane container]&lt;br&gt;Time-bounded, one-tenant access; every decision is audited." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacing=9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="175" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v4_api" value="&lt;b&gt;Cloud Run API / Router&lt;/b&gt;&lt;br&gt;[Container: Cloud Run]&lt;br&gt;Authenticates users, durably receives provider webhooks, resolves tenant, and executes tenant-scoped commands." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="410" width="285" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="v4_emr_adapter" value="&lt;b&gt;EMR Adapters&lt;/b&gt;&lt;br&gt;[Container: functions/services]&lt;br&gt;Vendor-specific boundary. Fetches open appointments from EMRs and performs appointment operations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="410" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="v4_notification" value="&lt;b&gt;Notification Worker&lt;/b&gt;&lt;br&gt;[Container: worker]&lt;br&gt;Applies consent and minimum-necessary rules, sends messages, and records delivery outcomes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="635" width="285" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="v4_batch" value="&lt;b&gt;Batch Workers&lt;/b&gt;&lt;br&gt;[Container: jobs/workers]&lt;br&gt;Runs one tenant per execution, pulls open appointments through the adapter, and advances workflows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="620" width="285" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="v4_tenant_guard" value="TENANT CONTEXT GUARD&lt;br&gt;tenant bound before PHI access · no cross-tenant joins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="370" width="350" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="v4_front" value="Front-office&lt;br&gt;user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
