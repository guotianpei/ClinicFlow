        <mxCell id="v4_secret" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;[Managed service]&lt;br&gt;Provider, EMR, tenant, and signing credentials. Secrets are not PHI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
