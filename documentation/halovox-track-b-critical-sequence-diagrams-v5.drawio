        <mxCell id="p8m8" value="9. Object operation using tenant token" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
